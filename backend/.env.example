PORT=5001
# Local: mongodb://127.0.0.1:27017/realestate
# Atlas: mongodb+srv://USER:PASS@cluster....mongodb.net/realestate?retryWrites=true&w=majority
# If password has @ # : / ? encode them: @ → %40  # → %23  : → %3A
MONGO_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/realestate?retryWrites=true&w=majority
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRE=30d
CLIENT_URL=http://localhost:3000
NODE_ENV=development

# Cloudinary (https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (Gmail: use an App Password with 2FA enabled)
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM_NAME=PropFinder
EMAIL_FROM_ADDRESS=
